# Discord bot
# Create your bot at https://discord.com/developers/applications
BOT_TOKEN=your-discord-bot-token-here

# The only Discord user the bot answers and DMs. Leave unset to use the
# application's owner (or team owner) from the Developer Portal.
# OWNER_ID=your-discord-user-id

# Scraping backend — set one key depending on your hosting environment.
# The bot tries Zyte first, then ScraperAPI, then falls back to a direct request.
# If you're hosting on a home/residential connection, Cloudflare won't block you
# and you can leave both keys unset.
#
# Zyte API (pay-as-you-go): https://www.zyte.com
ZYTE_API_KEY=your-zyte-api-key-here
#
# ScraperAPI (1,000 free credits/month): https://www.scraperapi.com
# SCRAPER_API_KEY=your-scraperapi-key-here

# How often each club tier is checked, in hours.
# Manual clubs are only checked while a starred match is waiting to open.
WATCHED_INTERVAL_HOURS=3
STANDARD_INTERVAL_HOURS=12
MANUAL_INTERVAL_HOURS=24

# Regular checks only run inside this window (24-hour clock). Checks timed to a
# registration opening run at any hour. SCRAPE_TIMEZONE is an IANA name.
SCRAPE_WINDOW_START=8
SCRAPE_WINDOW_END=21
SCRAPE_TIMEZONE=America/New_York

# DM the owner after this many checks in a row fail for every club they covered.
FAILURE_ALERT_THRESHOLD=3

# SQLite database location.
DB_PATH=data/matches.db
